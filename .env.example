# ==============================================================================
# Young Tours & Travels - Environment Configuration Template
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://travel_user:travel_password@localhost:5432/travel_db
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Redis Configuration (BullMQ & Cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Authentication & Security (RS256 Keys / Fallback HS256)
JWT_ALGORITHM=RS256
JWT_ACCESS_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN=604800
# For local dev / test, HMAC secret can be used if RS256 keypair is not generated
JWT_SECRET_KEY=super_secure_dev_jwt_secret_key_minimum_32_characters_long_12345
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Password Hashing Parameters (Argon2id)
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# Object Storage Configuration (S3 / MinIO / Local)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET_PRIVATE=travel-documents-private
S3_BUCKET_PUBLIC=travel-media-public
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# Operational Currency & Defaults
DEFAULT_CURRENCY=INR
HOLD_DURATION_MINUTES=15
